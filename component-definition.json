{
  "groups": [
    {
      "id": "blocks",
      "title": "Blocks",
      "components": [
        {
          "title": "Hero Carousel",
          "id": "hero-carousel",
          "model": "hero-carousel",
          "filter": "hero-carousel",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 1
            }
          }
        },
        {
          "title": "Hero Carousel Slide",
          "id": "hero-carousel-slide",
          "model": "hero-carousel-slide",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 6,
              "fields": [
                { "name": "kicker", "selector": "div:nth-child(1)" },
                { "name": "heading", "selector": "div:nth-child(2)" },
                { "name": "sub", "selector": "div:nth-child(3)" },
                { "name": "cta", "selector": "div:nth-child(4)" },
                { "name": "tone", "selector": "div:nth-child(5)" },
                { "name": "image", "selector": "div:nth-child(6)>picture>img[src]" },
                { "name": "imageAlt", "selector": "div:nth-child(6)>picture>img[alt]" }
              ]
            }
          }
        }
      ]
    }
  ]
}
